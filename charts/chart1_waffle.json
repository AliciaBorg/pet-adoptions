{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf9",
  "width": 360,
  "height": 360,
  "title": {
    "text": "Formal vs. Informal Pet Adoptions",
    "font": "DM Sans",
    "fontSize": 18,
    "fontWeight": 700,
    "color": "#1d2925",
    "subtitleFont": "DM Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#64716c",
    "offset": 15
  },
  "data": {
    "values": [
      {
        "Category": "Formally Adopted",
        "Percentage": 0.362,
        "Count": 36,
        "order": 1
      },
      {
        "Category": "Not Formally Adopted",
        "Percentage": 0.638,
        "Count": 64,
        "order": 2
      }
    ]
  },
  "transform": [
    {
      "_comment": "Create a sequence of numbers from 1 up to the category count.",
      "calculate": "sequence(1, datum.Count + 1)",
      "as": "sq"
    },
    {
      "_comment": "Turn each number in the sequence into its own data row.",
      "flatten": ["sq"]
    },
    {
      "_comment": "Give every waffle square a unique number, grouped by category order.",
      "window": [{"op": "row_number", "as": "id"}],
      "sort": [{"field": "order", "order": "ascending"}]
    },
    {
      "_comment": "Divide the square number by 10 to determine its row.",
      "calculate": "ceil(datum.id / 10)",
      "as": "row"
    },
    {
      "_comment": "Use the remainder after dividing by 10 to determine its column.",
      "calculate": "((datum.id - 1) % 10) + 1",
      "as": "col"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 2,
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {"step": 28}
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {"step": 28},
      "sort": "ascending"
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Formally Adopted",
          "Not Formally Adopted"
        ],
        "range": ["#2f5d50", "#b8b8b3"]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "Category", 
        "type": "nominal", 
        "title": "Acquisition Type:"
      },
      {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Share:",
        "format": ".1%"
      }
    ]
  }
}