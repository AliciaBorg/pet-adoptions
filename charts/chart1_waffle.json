{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 300,
  "title": {
    "text": "Most Australian Pets Aren't Actually 'Adopted'",
    "subtitle": "How Australians Acquired Their Pets, 2024",
    "fontSize": 15,
    "offset": 15
  },
  "data": {
    "values": [
      {
        "Category": "Not Formally Adopted (Breeder or Pet Shop)",
        "Percentage": 0.637,
        "Count": 64,
        "order": 1
      },
      {
        "Category": "Formally Adopted (Shelter or Adoption Agency)",
        "Percentage": 0.363,
        "Count": 36,
        "order": 2
      }
    ]
  },
  "transform": [
    {
      "calculate": "sequence(1, datum.Count + 1)",
      "as": "sq"
    },
    {"flatten": ["sq"]},
    {
      "window": [{"op": "row_number", "as": "id"}],
      "sort": [{"field": "order", "order": "ascending"}]
    },
    {
      "calculate": "ceil(datum.id / 10)",
      "as": "row"
    },
    {
      "calculate": "((datum.id - 1) % 10) + 1",
      "as": "col"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 2,
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {"step": 28}
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {"step": 28},
      "sort": "ascending"
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Not Formally Adopted (Breeder or Pet Shop)",
          "Formally Adopted (Shelter or Adoption Agency)"
        ],
        "range": ["#2b5c8f", "#d95f02"]
      },
      "legend": {
        "title": "Acquisition Type",
        "orient": "bottom",
        "columns": 1,
        "labelLimit": 0
      }
    },
    "tooltip": [
      {"field": "Category", "type": "nominal", "title": "Acquisition Type:"},
      {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Share:",
        "format": ".1%"
      }
    ]
  }
}