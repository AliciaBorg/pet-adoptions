{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf9",
  "width": 420,
  "height": 240,
  "title": {
    "text": "Median Days to Adoption Across Animal Size Tiers",
    "font": "DM Sans",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#1d2925",
    "offset": 15,
    "anchor": "middle"
  },
  "data": {
    "values": [
      {"size_tier": "Small", "animal": "Dogs", "median_tta": 12},
      {"size_tier": "Small", "animal": "Cats", "median_tta": 3},
      {"size_tier": "Medium", "animal": "Dogs", "median_tta": 20},
      {"size_tier": "Medium", "animal": "Cats", "median_tta": 6},
      {"size_tier": "Large", "animal": "Dogs", "median_tta": 23},
      {"size_tier": "Large", "animal": "Cats", "median_tta": 8}
    ]
  },
  "encoding": {
    "y": {
      "field": "size_tier",
      "type": "nominal",
      "title": null,
      "sort": ["Small", "Medium", "Large"],
      "axis": {"labelFontSize": 14, "labelPadding": 8}
    }
  },
  "layer": [
    {
      "transform": [
        {
          "pivot": "animal",
          "value": "median_tta",
          "groupby": ["size_tier"]
        }
      ],
      "mark": {"type": "rule", "color": "#cbd5e1", "strokeWidth": 3},
      "encoding": {
        "x": {"field": "Dogs", "type": "quantitative"},
        "x2": {"field": "Cats"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 190},
      "encoding": {
        "x": {
          "field": "median_tta",
          "type": "quantitative",
          "title": "Median Time to Adoption (Days)",
          "scale": {"domain": [0, 30]},
          "axis": {"grid": true, "labelFontSize": 14, "titleFontSize": 14}
        },
        "color": {
          "field": "animal",
          "type": "nominal",
          "scale": {
            "domain": ["Dogs", "Cats"],
            "range": ["#2b5c8f", "#d95f02"]
          },
          "legend": {
            "title": null,
            "labelFontSize": 14,
            "symbolSize": 180,
            "orient": "top-right",
            "padding": 0
          }
        },
        "tooltip": [
          {"field": "size_tier", "type": "nominal", "title": "Size Tier:"},
          {"field": "animal", "type": "nominal", "title": "Species:"},
          {"field": "median_tta", "type": "quantitative", "title": "Median Days:"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 15,
        "fontWeight": "bold",
        "fill": "#334155"
      },
      "encoding": {
        "x": {
          "field": "median_tta",
          "type": "quantitative"
        },
        "text": {
          "field": "median_tta",
          "type": "quantitative",
          "format": "d"
        }
      }
    }
  ]
}