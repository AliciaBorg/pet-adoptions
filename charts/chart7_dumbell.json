{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf9",
  "width": 500,
  "height": 320,
  "title": {
    "text": "Selected Reasons Australians Don't Consider Adopting a Dog or Cat",
    "fontSize": 20,
    "offset": 24,
    "anchor": "middle"
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"domain": false}
  },
  "data": {
    "values": [
      {"reason": "I would prefer a young puppy/kitten", "animal": "Dogs", "percentage": 39},
      {"reason": "I would prefer a young puppy/kitten", "animal": "Cats", "percentage": 32},
      {"reason": "I was looking for a particular breed", "animal": "Dogs", "percentage": 38},
      {"reason": "I was looking for a particular breed", "animal": "Cats", "percentage": 38},
      {"reason": "I just didn't think to do so", "animal": "Dogs", "percentage": 20},
      {"reason": "I just didn't think to do so", "animal": "Cats", "percentage": 23},
      {"reason": "Concerns about potential behavioural issues", "animal": "Dogs", "percentage": 17},
      {"reason": "Concerns about potential behavioural issues", "animal": "Cats", "percentage": 12},
      {"reason": "No particular reason", "animal": "Dogs", "percentage": 12},
      {"reason": "No particular reason", "animal": "Cats", "percentage": 17},
      {"reason": "There are no rescue shelters near me", "animal": "Dogs", "percentage": 10},
      {"reason": "There are no rescue shelters near me", "animal": "Cats", "percentage": 7},
      {"reason": "Concerns about potential health issues", "animal": "Dogs", "percentage": 9},
      {"reason": "Concerns about potential health issues", "animal": "Cats", "percentage": 11},
      {"reason": "Another reason", "animal": "Dogs", "percentage": 7},
      {"reason": "Another reason", "animal": "Cats", "percentage": 4},
      {"reason": "I've had negative experiences with a dog/cat", "animal": "Dogs", "percentage": 4},
      {"reason": "I've had negative experiences with a dog/cat", "animal": "Cats", "percentage": 8}
    ]
  },
  "transform": [
    {
      "calculate": "datum.animal == 'Dogs' ? -datum.percentage : datum.percentage",
      "as": "signed_percentage"
    }
  ],
  "encoding": {
    "y": {
      "field": "reason",
      "type": "nominal",
      "title": null,
      "sort": [
        "I would prefer a young puppy/kitten",
        "I was looking for a particular breed",
        "I just didn't think to do so",
        "Concerns about potential behavioural issues",
        "No particular reason",
        "There are no rescue shelters near me",
        "Concerns about potential health issues",
        "Another reason",
        "I've had negative experiences with a dog/cat"
      ],
      "axis": {
        "labelLimit": 350,
        "labelPadding": 14,
        "labelFontSize": 13,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "size": 15, "opacity": 1},
      "encoding": {
        "x": {
          "field": "signed_percentage",
          "type": "quantitative",
          "title": "Percent Selecting (%)",
          "scale": {"domain": [-48, 48], "zero": true, "padding": 0},
          "axis": {
            "grid": true,
            "labelFontSize": 13,
            "titleFontSize": 14,
            "titlePadding": 18,
            "labelExpr": "abs(datum.value)"
          }
        },
        "x2": {"value": 0},
        "color": {
          "field": "animal",
          "type": "nominal",
          "scale": {
            "domain": ["Dogs", "Cats"],
            "range": ["#2b5c8f", "#d95f02"]
          },
          "legend": {
            "title": null,
            "labelFontSize": 15,
            "orient": "none",
            "legendX": 425,
            "legendY": 190,
            "fillColor": "#fffdf9",
            "strokeColor": "#d9ddd7",
            "padding": 6,
            "cornerRadius": 4
          }
        },
        "tooltip": [
          {"field": "reason", "type": "nominal", "title": "Reason:"},
          {"field": "animal", "type": "nominal", "title": "Pet Type:"},
          {"field": "percentage", "type": "quantitative", "title": "Percent Selecting (%):"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#334155",
        "dx": {"expr": "datum.animal == 'Dogs' ? -6 : 6"},
        "align": {"expr": "datum.animal == 'Dogs' ? 'right' : 'left'"}
      },
      "encoding": {
        "x": {"field": "signed_percentage", "type": "quantitative"},
        "text": {"field": "percentage", "type": "quantitative", "format": "d"}
      }
    }
  ]
}
