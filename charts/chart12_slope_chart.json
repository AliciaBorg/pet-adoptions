{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf9",
  "width": 600,
  "height": 440,
  "padding": {"left": 60, "right": 60, "top": 45, "bottom": 55},
  "config": {
    "view": {"stroke": null},
    "axis": {"grid": false}
  },
  "title": {
    "text": [
      "The Concerning Decline in PetRescue",
      "Adoption Rates During 2025"
    ],
    "font": "DM Sans",
    "fontWeight": 700,
    "color": "#1d2925",
    "fontSize": 24,
    "offset": 30
  },
  "data": {
    "values": [
      {"animal": "Dogs", "month": "Jan 2025", "rate": 91.9},
      {"animal": "Dogs", "month": "Dec 2025", "rate": 54.4},
      {"animal": "Cats", "month": "Jan 2025", "rate": 93.3},
      {"animal": "Cats", "month": "Dec 2025", "rate": 62.6},
      {"animal": "All pets", "month": "Jan 2025", "rate": 92.4},
      {"animal": "All pets", "month": "Dec 2025", "rate": 60.2}
    ]
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "nominal",
      "sort": null,
      "scale": {"domain": ["Jan 2025", "Dec 2025"], "padding": 0.1},
      "axis": {
        "title": null,
        "labels": true,
        "labelExpr": "datum.label === 'Jan 2025' ? 'January' : 'December'",
        "labelFontSize": 16,
        "labelFontWeight": "bold",
        "ticks": false,
        "domain": false,
        "orient": "top",
        "labelAngle": 0,
        "labelPadding": 2
      }
    },
    "y": {
      "field": "rate",
      "type": "quantitative",
      "axis": null,
      "scale": {"domain": [48, 100]}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#9ca3af",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {"field": "month", "type": "nominal"},
        "y": {"datum": 48},
        "y2": {"datum": 98}
      }
    },
    {
      "mark": {"type": "line", "strokeWidth": 3},
      "encoding": {
        "tooltip": [
          {"field": "animal", "type": "nominal", "title": "Species:"},
          {"field": "month", "type": "nominal", "title": "Month:"},
          {"field": "rate", "type": "quantitative", "title": "Adoption Rate (%):", "format": ".1f"}
        ],
        "color": {
          "field": "animal",
          "type": "nominal",
          "scale": {
            "domain": ["Dogs", "Cats", "All pets"],
            "range": ["#2563eb", "#f97316", "#2f5d50"]
          },
          "legend": {
            "title": null,
            "orient": "top-right",
            "labelFontSize": 18,
            "symbolType": "circle",
            "symbolSize": 150
          }
        },
        "detail": {"field": "animal"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 170, "opacity": 0.7},
      "encoding": {
        "tooltip": [
          {"field": "animal", "type": "nominal", "title": "Species:"},
          {"field": "month", "type": "nominal", "title": "Month:"},
          {"field": "rate", "type": "quantitative", "title": "Adoption Rate (%):", "format": ".1f"}
        ],
        "color": {
          "field": "animal",
          "type": "nominal",
          "scale": {
            "domain": ["Dogs", "Cats", "All pets"],
            "range": ["#2563eb", "#f97316", "#2f5d50"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": 0,
        "fontSize": 18,
        "fontWeight": "bold"
      },
      "transform": [{"filter": "datum.month == 'Jan 2025' && datum.animal == 'All pets'"}],
      "encoding": {
        "text": {"field": "rate", "type": "quantitative", "format": ".1f"},
        "color": {
          "field": "animal",
          "type": "nominal",
          "scale": {
            "domain": ["Dogs", "Cats", "All pets"],
            "range": ["#2563eb", "#f97316", "#2f5d50"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": -14,
        "fontSize": 18,
        "fontWeight": "bold"
      },
      "transform": [{"filter": "datum.month == 'Jan 2025' && datum.animal == 'Cats'"}],
      "encoding": {
        "text": {"field": "rate", "type": "quantitative", "format": ".1f"},
        "color": {
          "field": "animal",
          "type": "nominal",
          "scale": {
            "domain": ["Dogs", "Cats", "All pets"],
            "range": ["#2563eb", "#f97316", "#2f5d50"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": 14,
        "fontSize": 18,
        "fontWeight": "bold"
      },
      "transform": [{"filter": "datum.month == 'Jan 2025' && datum.animal == 'Dogs'"}],
      "encoding": {
        "text": {"field": "rate", "type": "quantitative", "format": ".1f"},
        "color": {
          "field": "animal",
          "type": "nominal",
          "scale": {
            "domain": ["Dogs", "Cats", "All pets"],
            "range": ["#2563eb", "#f97316", "#2f5d50"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 18,
        "fontWeight": "bold"
      },
      "transform": [{"filter": "datum.month == 'Dec 2025'"}],
      "encoding": {
        "text": {"field": "rate", "type": "quantitative", "format": ".1f"},
        "color": {
          "field": "animal",
          "type": "nominal",
          "scale": {
            "domain": ["Dogs", "Cats", "All pets"],
            "range": ["#2563eb", "#f97316", "#2f5d50"]
          },
          "legend": null
        }
      }
    }
  ]
}
