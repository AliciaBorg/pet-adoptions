{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf9",
  "width": 650,
  "height": 420,
  "view": {"stroke": null},
  "title": {
    "text": "Rescue organisations cluster in the east",
    "font": "DM Sans",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#1d2925",
    "subtitleFont": "DM Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#64716c",
    "anchor": "middle",
    "offset": 15
  },
  "data": {
    "values": [
      {
        "state": "New South Wales",
        "total_orgs": 240,
