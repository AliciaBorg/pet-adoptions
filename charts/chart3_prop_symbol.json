        "total_orgs": 4,
        "councils": 0,
        "rescues": 2,
        "shelters": 1,
        "vets": 1,
        "lat": -35.3,
        "lon": 149.1
      },
      {
        "state": "Tasmania",
        "total_orgs": 3,
        "councils": 0,
        "rescues": 1,
        "shelters": 2,
        "vets": 0,
        "lat": -42.0,
        "lon": 146.5
      },
      {
        "state": "Northern Territory",
        "total_orgs": 2,
