        "rescues": 1,
        "shelters": 1,
        "vets": 0,
        "lat": -19.5,
        "lon": 133.5
      }
    ]
  },
  "transform": [
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
          "format": {"type": "json", "property": "features"}
        },
        "key": "properties.STATE_NAME"
      },
      "as": "geo"
    },
    {
      "calculate": "max(14, datum.total_orgs * 1.4)",
      "as": "h"
    },
    {
      "calculate": "'M -8 0 L 8 0 L 0 -' + datum.h + ' Z'",
      "as": "spike_shape"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#edebe0",
        "stroke": "#cfcdc2",
        "strokeWidth": 1.5
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State/Territory:"},
          {"field": "total_orgs", "type": "quantitative", "title": "Total Organisations:", "format": ","},
          {"field": "rescues", "type": "quantitative", "title": "Rescue Groups:"},
          {"field": "shelters", "type": "quantitative", "title": "Shelters:"},
          {"field": "councils", "type": "quantitative", "title": "Councils:"},
          {"field": "vets", "type": "quantitative", "title": "Vet Clinics:"}
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "fill": "#4a4b4d",
        "stroke": "#020202",
        "strokeWidth": 1,
        "opacity": 0.9,
        "size": 1
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "shape": {
          "field": "spike_shape",
          "type": "nominal",
          "scale": null
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State/Territory:"},
          {"field": "total_orgs", "type": "quantitative", "title": "Total Organisations:", "format": ","},
          {"field": "rescues", "type": "quantitative", "title": "Rescue Groups:"},
          {"field": "shelters", "type": "quantitative", "title": "Shelters:"},
          {"field": "councils", "type": "quantitative", "title": "Councils:"},
          {"field": "vets", "type": "quantitative", "title": "Vet Clinics:"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 12,
        "dy": 12,
        "color": "#1e293b"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "total_orgs", "type": "quantitative", "format": ","}
      }
    },
    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "fontSize": 13,
        "fontStyle": "italic",
        "color": "#6b7280",
        "lineHeight": 14
      },
      "encoding": {
        "x": {"value": 210},
        "y": {"value": 440},
        "text": {
          "value": [
            "* Member organisations include: Rescue Groups,",
            "Shelters, Local Councils & Vet Clinics."
          ]
        }
      }
    }
  ]
}