{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 280,
  "title": {
    "text": "Rehoming is the Likely Outcome",
    "subtitle": "Adoption Outcomes for Dogs and Cats, 2024",
    "fontSize": 16,
    "offset": 15
  },
  "data": {
    "values": [
      {"category": "Dogs", "outcome": "Currently in Care", "count": 1672},
      {"category": "Dogs", "outcome": "Reclaimed", "count": 3203},
      {"category": "Dogs", "outcome": "Returned", "count": 727},
      {"category": "Dogs", "outcome": "Rehomed", "count": 6839},
      {"category": "Dogs", "outcome": "Transferred", "count": 529},
      {"category": "Dogs", "outcome": "Euthanased", "count": 2768},
      {"category": "Dogs", "outcome": "Other", "count": 114},

      {"category": "Cats", "outcome": "Currently in Care", "count": 2128},
      {"category": "Cats", "outcome": "Reclaimed", "count": 979},
      {"category": "Cats", "outcome": "Returned", "count": 381},
      {"category": "Cats", "outcome": "Rehomed", "count": 16445},
      {"category": "Cats", "outcome": "Transferred", "count": 298},
      {"category": "Cats", "outcome": "Euthanased", "count": 5089},
      {"category": "Cats", "outcome": "Other", "count": 319}
    ]
  },
  "transform": [
    {
      "joinaggregate": [
        {"op": "sum", "field": "count", "as": "total_category_count"}
      ],
      "groupby": ["category"]
    },
    {
      "calculate": "(datum.count / datum.total_category_count) * 100",
      "as": "percentage"
    }
  ],
  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "category",
          "type": "nominal",
          "title": "Pet Species",
          "sort": ["Dogs", "Cats"]
        },
        "y": {
          "field": "outcome",
          "type": "nominal",
          "title": "Outcome Type",
          "sort": [
            "Currently in Care",
            "Reclaimed",
            "Returned",
            "Rehomed",
            "Transferred",
            "Euthanased",
            "Other"
          ]
        },
        "color": {
          "field": "percentage",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges",
            "domain": [0, 70]
          },
          "legend": {
            "title": "Outcome Liklihood (%)",
            "format": ".0f",
            "values": [0, 10, 20, 30, 40, 50, 60, 70]
          }
        },
        "tooltip": [
          {"field": "category", "type": "nominal", "title": "Pet Species:"},
          {"field": "outcome", "type": "nominal", "title": "Outcome Type:"},
          {"field": "percentage", "type": "quantitative", "title": "Percentage:", "format": ".1f"},
          {"field": "count", "type": "quantitative", "title": "Total Count:", "format": ","}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "category",
          "type": "nominal",
          "sort": ["Dogs", "Cats"]
        },
        "y": {
          "field": "outcome",
          "type": "nominal",
          "sort": [
            "Currently in Care",
            "Reclaimed",
            "Returned",
            "Rehomed",
            "Transferred",
            "Euthanased",
            "Other"
          ]
        },
        "text": {"field": "percentage", "type": "quantitative", "format": ".0f"},
        "color": {
          "condition": {
            "test": "datum.percentage > 35",
            "value": "#ffffff"
          },
          "value": "#111827"
        }
      }
    }
  ]
}