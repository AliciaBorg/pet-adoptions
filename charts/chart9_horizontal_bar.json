          "scale": {
            "domain": ["Dogs", "Cats"],
            "range": ["#2b5c8f", "#d95f02"]
          },
          "legend": {
            "title": null,
            "labelFontSize": 14,
            "titleFontSize": 13,
            "labelFontSize": 12,
            "orient": "none",
            "legendX": 270,
            "legendY": 10,
