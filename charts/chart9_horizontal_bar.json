  "data": {
    "values": [
      {"organisation": "Shelter", "animal": "Dogs", "median_tta": 4, "adoption_rate": 87},
      {"organisation": "Shelter", "animal": "Cats", "median_tta": 3, "adoption_rate": 92},
      {"organisation": "Council", "animal": "Dogs", "median_tta": 10, "adoption_rate": 84},
      {"organisation": "Council", "animal": "Cats", "median_tta": 9, "adoption_rate": 90},
      {"organisation": "Vet", "animal": "Dogs", "median_tta": 17, "adoption_rate": 87},
      {"organisation": "Vet", "animal": "Cats", "median_tta": 16, "adoption_rate": 78},
