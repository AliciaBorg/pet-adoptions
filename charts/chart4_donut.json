{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#fffdf9",
  "width": 500,
  "height": 380,
  "title": {
    "text": "Dogs and Cats Dominate the Adoption Picture",
    "subtitle": "Proportion of PetRescue Adoptions by Species, 2025",
    "fontSize": 16,
    "offset": 15
  },
  "data": {
    "values": [
      {"species": "Dogs", "count": 24015},
      {"species": "Cats", "count": 43407},
      {"species": "Other pets", "count": 2281}
    ]
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "total_count"
        }
      ]
    },
    {
      "calculate": "datum.count / datum.total_count",
      "as": "percent"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 90,
        "outerRadius": 160,
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "count",
          "type": "quantitative",
          "stack": true
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "title": "Species",
          "scale": {
            "domain": ["Dogs", "Cats", "Other pets"],
            "range": ["#2563eb", "#ea580c", "#16a34a"]
          }
        },
        "order": {
          "field": "count",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {"field": "species", "type": "nominal", "title": "Species"},
          {"field": "count", "type": "quantitative", "title": "Adoptions", "format": ","},
          {"field": "percent", "type": "quantitative", "title": "Share", "format": ".1%"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 125,
        "fontSize": 13,
        "fontWeight": "bold",
        "fill": "#ffffff"
      },
      "encoding": {
        "theta": {
          "field": "count",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "count",
          "type": "quantitative",
          "sort": "descending"
        },
        "text": {
          "field": "percent",
          "type": "quantitative",
          "format": ".0%"
        }
      }
    }
  ]
}